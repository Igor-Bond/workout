rules_version = '2';

// Правила доступа к Firestore проекта «Трекер тренировок» (§40 ТЗ).
//
// Идентификатор проекта и ключ веб-приложения не секретны: Google по замыслу
// встраивает их в клиентский код, и любой посетитель сайта их видит. Данные
// защищают именно эти правила — и ничто больше.
//
// Всё, что не разрешено явно, Firestore запрещает по умолчанию, поэтому
// отдельного запрещающего блока в конце не нужно.
//
// Загружать: консоль Firebase → Firestore Database → Rules → вставить →
// Publish. Файл в репозитории — эталон для сверки с развёрнутым.

service cloud.firestore {
  match /databases/{database}/documents {

    // Каждый пользователь видит и меняет только свои данные.
    // Без этого правила чужой человек, знающий ваш конфиг,
    // мог бы прочитать всю историю тренировок.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Справочник упражнений, шаблоны и тренировки лежат подколлекциями
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Анкета тестировщика (§52) — ящик без обратной стороны.
    //
    // Положить ответ может любой, в том числе не входивший в учётную
    // запись: человека, которого позвали посмотреть приложение, нельзя
    // заставлять заводить отношения с Google ради отзыва.
    //
    // Достать не может никто. Ответы читаются в консоли Firebase, и
    // тестировщики не видят ответов друг друга — в отличие от анкеты,
    // хранящей их прямо в своей странице.
    //
    // Проверка формы — не защита от злого умысла, а предел ущерба:
    // случайный или намеренный мусор ограничен тремя полями и разумным
    // числом ключей.
    match /feedback/{entry} {
      allow create: if request.resource.data.keys().hasOnly(['at', 'answers', 'about'])
                    && request.resource.data.at is string
                    && request.resource.data.at.size() < 40
                    && request.resource.data.answers is map
                    && request.resource.data.answers.size() <= 40
                    && request.resource.data.about is map
                    && request.resource.data.about.size() <= 20;

      allow read, update, delete: if false;
    }
  }
}
